# Rename this file to .env then populate the variables with values from RA162-SK.json file
AICORE_AUTH_URL=<url in AI Core service key>/oauth/token
AICORE_CLIENT_ID=<clientid in AI Core service key>
AICORE_CLIENT_SECRET=<clientsecret in AI Core service key>
AICORE_RESOURCE_GROUP=default
AICORE_BASE_URL=<AI_API_URL in AI Core service key>
BASE_DEPLOYMENT_URL=<AI_API_URL in AI Core service key>/v2/inference/deployments
RPT_DEPLOYMENT_ID=<sap-rpt-1.6 deployment ID in AI Core>
RPT_LARGE_DEPLOYMENT_ID=<sap-rpt-1.6-large deployment ID in AI Core>
TABPFN_DEPLOYMENT_ID=<tabpfn-3.5-plus deployment ID in AI Core>
TABORC_DEPLOYMENT_ID=<tabular-orchestration deployment ID in AI Core>
TABORC_HDLFS_HOST=<UUID in the HDLFS URL>
TABORC_HDLFS_URL=<HDLFS URL>
